# Gemini API key for repo analysis: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Neon Postgres connection string (search history). Run `pnpm db:init` after setting it.
DATABASE_URL=

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (login). Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Groq API key (primary AI provider; Gemini is the fallback): https://console.groq.com/keys
GROQ_API_KEY=
